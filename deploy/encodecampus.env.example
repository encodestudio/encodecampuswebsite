# Copy to /etc/encodecampus.env  (chown root:encodecampus, chmod 640)
# Systemd EnvironmentFile — KEY=VALUE, no quotes, no `export`.

DJANGO_SECRET_KEY=REPLACE_WITH_64_RANDOM_CHARS
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=encodecampus.encodestudio.in
CSRF_TRUSTED_ORIGINS=https://encodecampus.encodestudio.in
CORS_ALLOWED_ORIGINS=https://encodecampus.encodestudio.in

# MySQL running on this instance
DB_NAME=EncodeCampusWebsite
DB_USER=encodecampus
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306

# Set to False only if you terminate TLS at Cloudflare with "Flexible" SSL
# (not recommended). Leave True when nginx serves HTTPS directly.
DJANGO_SSL_REDIRECT=True
